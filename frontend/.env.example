# URL of the backend API (your Render service), no trailing slash.
# Local dev falls back to http://localhost:8000 when this is unset.
VITE_API_BASE_URL="https://YOUR-SERVICE.onrender.com"

# Optional. Only if the backend sets CHECKSUM_API_KEY. VITE_ values are
# baked into the public JS bundle, so this is not a real secret.
# VITE_API_KEY=""
